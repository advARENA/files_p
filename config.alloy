// ===== Loki destination =====
loki.write "to_loki" {
  endpoint {
    // Если Loki на этом же сервере
    url = "http://127.0.0.1:3100/loki/api/v1/push"
  }
}

// ===== Read log file =====
local.file_match "app_logs" {
  path_targets = [
    {
      __path__ = "/var/www/html/ii_module1/logs_loki.jsonl", // <-- путь к твоему файлу
      job      = "ii_module1",
      host     = "server-1",
    },
  ]
}

loki.source.file "app_logs" {
  targets    = local.file_match.app_logs.targets
  forward_to = [loki.process.parse_json.receiver]
  tail_from_end = true
}

// ===== Parse JSON lines =====
loki.process "parse_json" {
  // Извлекаем поля из каждой JSON-строки
  stage.json {
    expressions = {
      ts          = "ts",
      level       = "level",
      component   = "component",
      parser_name = "parser_name",
      message     = "message",
    }
  }

  // Берем timestamp из поля ts (RFC3339Nano подходит для ISO со временем)
  stage.timestamp {
    source = "ts"
    format = "RFC3339Nano"
  }

  // Делаем часть полей лейблами (осторожно с высокой кардинальностью)
  stage.labels {
    values = {
      level       = "level",
      component   = "component",
      parser_name = "parser_name",
    }
  }

  // Текстом лога в Loki будет поле message
  stage.output {
    source = "message"
  }

  forward_to = [loki.write.to_loki.receiver]
}
